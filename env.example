# =============================================================================
# eRental - example environment variables
# =============================================================================
# HOW TO USE
#   1. Copy this file to a new file named ".env" in the project root.
#   2. Replace the placeholder values with the values from your own Supabase
#      project (Supabase dashboard -> Project Settings -> API).
#   3. NEVER commit ".env". Only this ".env.example" file belongs in Git.
#
# FRONTEND SAFETY - PLEASE READ
#   Every variable that starts with "VITE_" is bundled into the website and
#   can be seen by anyone who opens it. Because of this, ONLY the Supabase
#   publishable / anon key belongs in these variables.
#
#   NEVER put the Supabase "service_role" key (or the newer "secret" key),
#   your database password, or any other private key in this file or in any
#   VITE_ variable. Keep those out of this repository entirely.
# =============================================================================

# Your Supabase project URL
VITE_SUPABASE_URL=your_supabase_project_url_here

# Your Supabase publishable / anon key (safe for the frontend, NOT the service_role key)
VITE_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key_here
